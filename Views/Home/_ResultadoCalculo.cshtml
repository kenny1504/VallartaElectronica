@model ElectronicaVallarta.Modelos.Dto.ResultadoCalculoDto

@if (!Model.EsExitoso)
{
    <div class="rounded-[1.75rem] border border-red-200 bg-red-50 p-4 text-red-700 sm:p-5">
        <p class="text-xs font-black uppercase tracking-[0.22em] text-rojoMarca">No disponible</p>
        <h3 class="mt-2 text-lg font-black text-tinta sm:mt-3 sm:text-xl">No pudimos calcular tu cotizacion</h3>
        <p class="mt-2 text-sm leading-6 sm:mt-3 sm:leading-7">@Model.Mensaje</p>
    </div>
}
else
{
    <div class="min-w-0 overflow-x-hidden rounded-[1.75rem] border border-emerald-200 bg-[linear-gradient(180deg,_#f6fffb_0%,_#edfef7_100%)] p-3 text-tinta sm:p-5"
         data-resultado-exitoso="true"
         data-resultado-monto-usd="@Model.MontoUsd.ToString(System.Globalization.CultureInfo.InvariantCulture)"
         data-resultado-monto-recibe="@Model.MontoRecibe.ToString(System.Globalization.CultureInfo.InvariantCulture)"
         data-resultado-tasa="@Model.TasaCambioAplicada.ToString(System.Globalization.CultureInfo.InvariantCulture)"
         data-resultado-moneda="@Model.MonedaDestino">
        <div class="min-w-0">
            <p class="text-xs font-semibold text-slate-600 sm:text-sm">Tu envias</p>
            <h3 class="mt-1 break-words text-2xl font-black text-tinta sm:mt-2 sm:text-4xl">USD @Model.MontoUsd.ToString("N2")</h3>
        </div>

        <div class="mt-3 grid grid-cols-1 gap-2 sm:mt-5 sm:grid-cols-2 sm:gap-4">
            <div class="min-w-0 rounded-3xl bg-white p-2.5 shadow-sm sm:p-4">
                <p class="text-xs font-semibold text-slate-500 sm:text-sm">Pagador seleccionado</p>
                <p class="mt-1.5 break-words text-lg font-black text-tinta sm:mt-2 sm:text-2xl">@Model.NombreSucursal</p>
                <p class="mt-1 text-xs text-slate-600 sm:text-sm">@Model.NombrePais</p>
            </div>
            <div class="min-w-0 rounded-3xl bg-white p-2.5 shadow-sm sm:p-4">
                <p class="text-xs font-semibold text-slate-500 sm:text-sm">Tipo de cambio aplicado</p>
                <p class="mt-1.5 break-words text-2xl font-black leading-tight text-emerald-700 sm:mt-2 sm:text-3xl">
                    @Model.TasaCambioAplicada.ToString("N2") <span class="text-xs font-bold text-slate-600 sm:text-sm">@Model.MonedaDestino por USD</span>
                </p>
                <p class="mt-1 text-xs leading-4 text-slate-600 sm:leading-5 sm:text-sm">Actualizado: @Model.FechaTasa.ToString("MM/dd/yyyy")</p>
            </div>
        </div>

        <div class="mt-2 min-w-0 rounded-3xl bg-tinta p-3 text-white shadow-sm sm:mt-4 sm:p-5">
            <p class="text-xs font-semibold text-slate-300 sm:text-sm">Recibe en pais destino</p>
            <p class="mt-1.5 break-words text-3xl font-black text-emerald-300 sm:mt-3 sm:text-5xl">@Model.MonedaDestino @Model.MontoRecibe.ToString("N2")</p>
        </div>
    </div>
}
