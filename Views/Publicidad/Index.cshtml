@model IReadOnlyCollection<ElectronicaVallarta.Modelos.Dto.PublicidadActivaDto>
@{
    Layout = null;
    ViewData["Title"] = "Publicidad";
    var primeraPublicidad = Model.FirstOrDefault();
    var publicidadesIniciales = System.Text.Json.JsonSerializer.Serialize(
        Model,
        new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase });
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Electronica Vallarta</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        html,
        body {
            width: 100%;
            height: 100%;
            margin: 0;
            overflow: hidden;
            background: #020617;
        }

        body {
            overscroll-behavior: none;
        }

        .pantalla-publicitaria {
            position: fixed;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100vw;
            height: 100vh;
            background:
                radial-gradient(circle at 50% 50%, rgba(58, 160, 243, 0.16), transparent 46%),
                #020617;
        }

        .pantalla-publicitaria__visor {
            position: relative;
            z-index: 1;
            width: 100vw;
            height: 100vh;
            max-width: calc(100vh * 16 / 9);
            max-height: calc(100vw * 9 / 16);
            background: #000;
            overflow: hidden;
        }

        .pantalla-publicitaria__banderas {
            position: fixed;
            top: clamp(1rem, 2.8vw, 2.25rem);
            left: 50%;
            z-index: 4;
            display: flex;
            width: min(32rem, calc(100vw - 2rem));
            transform: translateX(-50%);
            align-items: center;
            justify-content: space-between;
            gap: clamp(0.5rem, 2vw, 1.25rem);
            opacity: 0;
            filter: saturate(0.88) drop-shadow(0 16px 26px rgba(0, 0, 0, 0.25));
            pointer-events: none;
        }

        .pantalla-publicitaria__banderas .decoracion-mundial__bandera {
            width: clamp(4.25rem, 11vw, 7.5rem);
            height: clamp(2.4rem, 6.2vw, 4.2rem);
            opacity: 1;
        }

        .pantalla-publicitaria__balon-fugaz {
            position: fixed;
            top: 16vh;
            left: 0;
            z-index: 5;
            width: clamp(5.75rem, 10vw, 11rem);
            aspect-ratio: 1;
            border-radius: 999px;
            background:
                radial-gradient(circle at 50% 50%, #151515 0 13%, transparent 14%),
                radial-gradient(circle at 50% 10%, #151515 0 9%, transparent 10%),
                radial-gradient(circle at 86% 38%, #151515 0 8%, transparent 9%),
                radial-gradient(circle at 70% 86%, #151515 0 8%, transparent 9%),
                radial-gradient(circle at 30% 86%, #151515 0 8%, transparent 9%),
                radial-gradient(circle at 14% 38%, #151515 0 8%, transparent 9%),
                conic-gradient(from 18deg, #ffffff 0 12%, #e6edf5 12% 24%, #ffffff 24% 36%, #e6edf5 36% 48%, #ffffff 48% 60%, #e6edf5 60% 72%, #ffffff 72% 84%, #e6edf5 84% 100%);
            box-shadow:
                inset -0.6rem -0.7rem 1rem rgba(2, 6, 23, 0.3),
                inset 0.46rem 0.42rem 0.85rem rgba(255, 255, 255, 0.78),
                0 1.4rem 2.4rem rgba(2, 6, 23, 0.28),
                0 0 1.15rem rgba(255, 255, 255, 0.42);
            opacity: 0;
            pointer-events: none;
        }

        .pantalla-publicitaria--evento-balon .pantalla-publicitaria__banderas {
            animation: mostrarBanderasBalonFugaz 7s linear;
        }

        .pantalla-publicitaria--evento-balon .pantalla-publicitaria__balon-fugaz {
            animation: cruzarBalonFugaz 6.8s linear;
        }

        .pantalla-publicitaria__balon-fugaz::after {
            position: absolute;
            inset: 16%;
            content: "";
            border: 1px solid rgba(20, 50, 74, 0.2);
            border-radius: inherit;
        }

        .pantalla-publicitaria__visor--lleno {
            max-width: none;
            max-height: none;
        }

        .publicidad-media {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: contain;
            opacity: 0;
            transform: scale(1.005);
            transition: opacity 700ms ease, transform 900ms ease;
            background: #000;
        }

        .publicidad-media--visible {
            opacity: 1;
            transform: scale(1);
        }

        .publicidad-media--saliente {
            opacity: 0;
        }

        .boton-pantalla-completa {
            position: fixed;
            top: 1rem;
            right: 1rem;
            z-index: 20;
            width: 3rem;
            height: 3rem;
            border: 1px solid rgba(255, 255, 255, 0.18);
            border-radius: 999px;
            background: rgba(0, 0, 0, 0.28);
            opacity: 0.14;
            cursor: pointer;
            transition: opacity 180ms ease, background 180ms ease, transform 180ms ease;
        }

        .boton-pantalla-completa::before,
        .boton-pantalla-completa::after {
            position: absolute;
            inset: 0.78rem;
            content: "";
            border-color: rgba(255, 255, 255, 0.92);
            border-style: solid;
        }

        .boton-pantalla-completa::before {
            border-width: 2px 0 0 2px;
        }

        .boton-pantalla-completa::after {
            border-width: 0 2px 2px 0;
        }

        .boton-pantalla-completa:hover,
        .boton-pantalla-completa:focus-visible {
            opacity: 1;
            background: rgba(0, 0, 0, 0.55);
            transform: scale(1.04);
            outline: none;
        }

        .leyenda-desarrollo {
            position: fixed;
            right: 1.25rem;
            bottom: 1.25rem;
            z-index: 18;
            padding: 0.48rem 0.78rem;
            border: 1px solid rgba(255, 255, 255, 0.28);
            border-radius: 999px;
            background: rgba(2, 6, 23, 0.46);
            color: rgba(255, 255, 255, 0.88);
            font-family: inherit;
            font-size: clamp(0.76rem, 1.2vw, 0.92rem);
            font-weight: 650;
            letter-spacing: 0;
            box-shadow: 0 10px 24px rgba(0, 0, 0, 0.28);
            text-shadow: 0 1px 8px rgba(0, 0, 0, 0.86);
            backdrop-filter: blur(10px);
            pointer-events: auto;
        }

        .leyenda-desarrollo a {
            color: inherit;
            font-weight: 750;
            text-decoration: none;
        }

        .leyenda-desarrollo a:hover,
        .leyenda-desarrollo a:focus-visible {
            color: #ffffff;
            outline: none;
        }

        @@media (max-aspect-ratio: 4 / 3) {
            .pantalla-publicitaria__visor {
                max-width: 100vw;
                max-height: 100vh;
            }
        }

        @@keyframes cruzarBalonFugaz {
            0% {
                opacity: 0;
                transform: translate3d(-24vw, 14vh, 0) rotate(0deg) scale(0.98);
            }

            5% {
                opacity: 1;
                transform: translate3d(-10vw, 7vh, 0) rotate(90deg) scale(1);
            }

            14% {
                opacity: 1;
                transform: translate3d(8vw, 0, 0) rotate(210deg) scale(1.02);
            }

            24% {
                opacity: 1;
                transform: translate3d(27vw, 12vh, 0) rotate(360deg) scale(0.98);
            }

            34% {
                opacity: 1;
                transform: translate3d(45vw, 18vh, 0) rotate(510deg) scale(0.96);
            }

            45% {
                opacity: 1;
                transform: translate3d(63vw, 7vh, 0) rotate(675deg) scale(1.01);
            }

            58% {
                opacity: 1;
                transform: translate3d(80vw, 1vh, 0) rotate(855deg) scale(1.02);
            }

            72% {
                opacity: 1;
                transform: translate3d(98vw, 13vh, 0) rotate(1040deg) scale(0.98);
            }

            90% {
                opacity: 1;
                transform: translate3d(122vw, 5vh, 0) rotate(1260deg) scale(1);
            }

            100% {
                opacity: 0;
                transform: translate3d(134vw, 6vh, 0) rotate(1380deg) scale(1);
            }
        }

        @@keyframes mostrarBanderasBalonFugaz {
            0% {
                opacity: 0;
                transform: translateX(-50%) translateY(-0.35rem) scale(0.96);
            }

            8%,
            90% {
                opacity: 0.28;
                transform: translateX(-50%) translateY(0) scale(1);
            }

            100% {
                opacity: 0;
                transform: translateX(-50%) translateY(-0.35rem) scale(0.96);
            }
        }

        @@media (max-width: 768px) {
            .pantalla-publicitaria__banderas {
                top: 0.75rem;
                width: min(18rem, calc(100vw - 1rem));
            }

            .pantalla-publicitaria__balon-fugaz {
                top: 12vh;
                width: clamp(4.35rem, 18vw, 6.25rem);
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .pantalla-publicitaria__banderas,
            .pantalla-publicitaria__balon-fugaz {
                display: none;
            }
        }
    </style>
</head>
<body>
    <main id="modulo-publicidad"
          class="pantalla-publicitaria"
          data-url-publicidad="/api/publicidad/activa"
          data-modo-pantalla="true"
          data-loop-videos="false">
        <section id="publicidad-visor"
                 class="pantalla-publicitaria__visor"
                 aria-label="Pantalla publicitaria"
                 aria-live="off">
            @if (primeraPublicidad is not null)
            {
                if (primeraPublicidad.TipoRecurso.Equals("Video", StringComparison.OrdinalIgnoreCase))
                {
                    <video class="publicidad-media publicidad-media--visible"
                           src="@primeraPublicidad.UrlRecurso"
                           muted
                           autoplay
                           playsinline
                           preload="auto"></video>
                }
                else
                {
                    <img class="publicidad-media publicidad-media--visible"
                         src="@primeraPublicidad.UrlRecurso"
                         alt="@primeraPublicidad.Titulo"
                         loading="eager"
                         decoding="async" />
                }
            }
        </section>
        <div class="pantalla-publicitaria__banderas" aria-hidden="true">
            <span class="decoracion-mundial__bandera decoracion-mundial__bandera--canada"></span>
            <span class="decoracion-mundial__bandera decoracion-mundial__bandera--mexico"></span>
            <span class="decoracion-mundial__bandera decoracion-mundial__bandera--estados-unidos"></span>
        </div>
        <div class="pantalla-publicitaria__balon-fugaz" aria-hidden="true"></div>
        <button id="botonPantallaCompletaPublicidad"
                class="boton-pantalla-completa"
                type="button"
                aria-label="Activar pantalla completa"></button>
        <p class="leyenda-desarrollo">
            Sistema desarrollado por
            <a href="https://www.ksoftech.com" target="_blank" rel="noopener noreferrer">www.ksoftech.com</a>
        </p>
    </main>

    <script id="datos-publicidad-inicial" type="application/json">@Html.Raw(publicidadesIniciales)</script>
    <script>
        (function () {
            var modulo = document.getElementById("modulo-publicidad");
            var visor = document.getElementById("publicidad-visor");
            var botonPantallaCompleta = document.getElementById("botonPantallaCompletaPublicidad");
            var datosIniciales = document.getElementById("datos-publicidad-inicial");
            var repetirVideos = modulo.getAttribute("data-loop-videos") === "true";
            var publicidades = [];
            var indiceActual = 0;
            var temporizador = null;
            var relojRevision = null;
            var recursoActual = visor ? visor.querySelector(".publicidad-media--visible") : null;
            var inicioRecursoActual = 0;
            var duracionRecursoActualMs = 0;
            var cargandoRecurso = false;
            var temporizadorBalonFugaz = null;
            var tiemposBalonFugazMs = [120000, 180000, 300000];
            var duracionBalonFugazMs = 6800;

            try {
                publicidades = JSON.parse(datosIniciales.textContent || "[]");
            } catch (error) {
                publicidades = [];
            }

            function limpiarTemporizador() {
                if (temporizador !== null) {
                    window.clearTimeout(temporizador);
                    temporizador = null;
                }
            }

            function programarAvance(segundos) {
                limpiarTemporizador();
                inicioRecursoActual = Date.now();
                duracionRecursoActualMs = Math.max(Number(segundos || 1), 1) * 1000;
                temporizador = window.setTimeout(avanzar, duracionRecursoActualMs);
            }

            function avanzar() {
                if (publicidades.length === 0 || cargandoRecurso) {
                    return;
                }

                indiceActual = (indiceActual + 1) % publicidades.length;
                mostrarPublicidadActual();
            }

            function precargarSiguiente() {
                if (publicidades.length < 2) {
                    return;
                }

                var siguiente = publicidades[(indiceActual + 1) % publicidades.length];
                if (String(siguiente.tipoRecurso).toLowerCase() === "imagen") {
                    var imagen = new Image();
                    imagen.src = siguiente.urlRecurso;
                    return;
                }

                var video = document.createElement("video");
                video.muted = true;
                video.playsInline = true;
                video.preload = "metadata";
                video.src = siguiente.urlRecurso;
            }

            function reemplazarRecurso(recursoNuevo) {
                var recursoAnterior = recursoActual;
                recursoActual = recursoNuevo;
                visor.appendChild(recursoNuevo);

                var activar = function () {
                    recursoNuevo.className = "publicidad-media publicidad-media--visible";
                    if (recursoAnterior) {
                        recursoAnterior.className = "publicidad-media publicidad-media--saliente";
                    }
                };

                if (window.requestAnimationFrame) {
                    window.requestAnimationFrame(activar);
                } else {
                    window.setTimeout(activar, 16);
                }

                if (recursoAnterior) {
                    window.setTimeout(function () {
                        if (recursoAnterior.tagName === "VIDEO") {
                            recursoAnterior.pause();
                            recursoAnterior.removeAttribute("src");
                            recursoAnterior.load();
                        }

                        recursoAnterior.remove();
                    }, 760);
                }
            }

            function manejarErrorCarga() {
                cargandoRecurso = false;
                window.setTimeout(avanzar, 1000);
            }

            function mostrarImagen(publicidad) {
                cargandoRecurso = true;
                var imagen = document.createElement("img");
                var cargada = false;
                imagen.alt = publicidad.titulo || "Publicidad";
                imagen.decoding = "async";
                imagen.loading = "eager";
                imagen.className = "publicidad-media";

                function completarCarga() {
                    if (cargada) {
                        return;
                    }

                    cargada = true;
                    cargandoRecurso = false;
                    reemplazarRecurso(imagen);
                    programarAvance(publicidad.duracionSegundos);
                    precargarSiguiente();
                }

                imagen.onload = completarCarga;
                imagen.onerror = manejarErrorCarga;
                imagen.src = publicidad.urlRecurso;

                if (imagen.complete && imagen.naturalWidth > 0) {
                    window.setTimeout(completarCarga, 0);
                }
            }

            function mostrarVideo(publicidad) {
                cargandoRecurso = true;
                var video = document.createElement("video");
                var cargado = false;
                video.className = "publicidad-media";
                video.muted = true;
                video.autoplay = true;
                video.playsInline = true;
                video.preload = "auto";
                video.loop = repetirVideos && publicidades.length === 1;

                function completarCargaVideo() {
                    if (cargado) {
                        return;
                    }

                    cargado = true;
                    cargandoRecurso = false;
                    reemplazarRecurso(video);
                    var reproduccion = video.play();
                    if (reproduccion && typeof reproduccion.catch === "function") {
                        reproduccion.catch(function () {
                            programarAvance(publicidad.duracionSegundos);
                        });
                    }

                    if (!video.loop) {
                        programarAvance(publicidad.duracionSegundos);
                    }

                    precargarSiguiente();
                }

                video.onloadeddata = completarCargaVideo;
                video.oncanplay = completarCargaVideo;
                if (!video.loop) {
                    video.onended = avanzar;
                }
                video.onerror = manejarErrorCarga;
                video.src = publicidad.urlRecurso;

                window.setTimeout(function () {
                    if (video.readyState >= 2) {
                        completarCargaVideo();
                    }
                }, 1500);
            }

            function mostrarPublicidadActual() {
                var publicidad = publicidades[indiceActual];
                if (!publicidad) {
                    return;
                }

                if (String(publicidad.tipoRecurso).toLowerCase() === "video") {
                    mostrarVideo(publicidad);
                    return;
                }

                mostrarImagen(publicidad);
            }

            function iniciarRelojRevision() {
                if (relojRevision !== null) {
                    return;
                }

                relojRevision = window.setInterval(function () {
                    if (publicidades.length < 2 || cargandoRecurso || duracionRecursoActualMs <= 0) {
                        return;
                    }

                    if (Date.now() - inicioRecursoActual >= duracionRecursoActualMs + 750) {
                        avanzar();
                    }
                }, 1000);
            }

            function obtenerEsperaBalonFugaz() {
                var indice = Math.floor(Math.random() * tiemposBalonFugazMs.length);
                return tiemposBalonFugazMs[indice];
            }

            function activarBalonFugaz() {
                if (!modulo) {
                    return;
                }

                modulo.classList.remove("pantalla-publicitaria--evento-balon");
                void modulo.offsetWidth;
                modulo.classList.add("pantalla-publicitaria--evento-balon");

                window.setTimeout(function () {
                    modulo.classList.remove("pantalla-publicitaria--evento-balon");
                }, duracionBalonFugazMs);
            }

            function programarBalonFugaz() {
                if (temporizadorBalonFugaz !== null) {
                    window.clearTimeout(temporizadorBalonFugaz);
                }

                temporizadorBalonFugaz = window.setTimeout(function () {
                    activarBalonFugaz();
                    programarBalonFugaz();
                }, obtenerEsperaBalonFugaz());
            }

            if (botonPantallaCompleta) {
                botonPantallaCompleta.addEventListener("click", function () {
                    try {
                        var elementoPantallaCompleta = document.fullscreenElement
                            || document.webkitFullscreenElement
                            || document.msFullscreenElement;

                        if (elementoPantallaCompleta) {
                            if (document.exitFullscreen) {
                                document.exitFullscreen();
                            } else if (document.webkitExitFullscreen) {
                                document.webkitExitFullscreen();
                            } else if (document.msExitFullscreen) {
                                document.msExitFullscreen();
                            }
                            return;
                        }

                        if (modulo.requestFullscreen) {
                            modulo.requestFullscreen();
                        } else if (modulo.webkitRequestFullscreen) {
                            modulo.webkitRequestFullscreen();
                        } else if (modulo.msRequestFullscreen) {
                            modulo.msRequestFullscreen();
                        }
                    } catch (error) {
                        botonPantallaCompleta.style.display = "none";
                    }
                });
            }

            if (publicidades.length > 0) {
                iniciarRelojRevision();
                window.setTimeout(activarBalonFugaz, 450);
                programarBalonFugaz();
                if (recursoActual) {
                    if (recursoActual.tagName === "VIDEO") {
                        recursoActual.muted = true;
                        recursoActual.autoplay = true;
                        recursoActual.playsInline = true;
                        if (typeof recursoActual.play === "function") {
                            try {
                                recursoActual.play();
                            } catch (error) {
                            }
                        }
                    }

                    programarAvance(publicidades[0].duracionSegundos);
                    precargarSiguiente();
                } else {
                    mostrarPublicidadActual();
                }
            }

            document.addEventListener("visibilitychange", function () {
                if (!document.hidden && publicidades.length > 1 && duracionRecursoActualMs > 0) {
                    programarAvance(Math.max(1, Math.ceil((duracionRecursoActualMs - (Date.now() - inicioRecursoActual)) / 1000)));
                }
            });
        })();
    </script>
</body>
</html>
