@model IReadOnlyCollection<ElectronicaVallarta.Modelos.Dto.PublicidadActivaDto>
@{
    Layout = null;
    ViewData["Title"] = "Publicidad";
    var primeraPublicidad = Model.FirstOrDefault();
    var publicidadesIniciales = System.Text.Json.JsonSerializer.Serialize(
        Model,
        new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase });
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Electronica Vallarta</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        html,
        body {
            width: 100%;
            height: 100%;
            margin: 0;
            overflow: hidden;
            background: #020617;
        }

        body {
            overscroll-behavior: none;
        }

        .pantalla-publicitaria {
            position: fixed;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100vw;
            height: 100vh;
            background:
                radial-gradient(circle at 50% 50%, rgba(58, 160, 243, 0.16), transparent 46%),
                #020617;
        }

        .pantalla-publicitaria__visor {
            position: relative;
            width: 100vw;
            height: 100vh;
            max-width: calc(100vh * 16 / 9);
            max-height: calc(100vw * 9 / 16);
            background: #000;
            overflow: hidden;
        }

        .pantalla-publicitaria__visor--lleno {
            max-width: none;
            max-height: none;
        }

        .publicidad-media {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: contain;
            opacity: 0;
            transform: scale(1.005);
            transition: opacity 700ms ease, transform 900ms ease;
            background: #000;
        }

        .publicidad-media--visible {
            opacity: 1;
            transform: scale(1);
        }

        .publicidad-media--saliente {
            opacity: 0;
        }

        .boton-pantalla-completa {
            position: fixed;
            top: 1rem;
            right: 1rem;
            z-index: 20;
            width: 3rem;
            height: 3rem;
            border: 1px solid rgba(255, 255, 255, 0.18);
            border-radius: 999px;
            background: rgba(0, 0, 0, 0.28);
            opacity: 0.14;
            cursor: pointer;
            transition: opacity 180ms ease, background 180ms ease, transform 180ms ease;
        }

        .boton-pantalla-completa::before,
        .boton-pantalla-completa::after {
            position: absolute;
            inset: 0.78rem;
            content: "";
            border-color: rgba(255, 255, 255, 0.92);
            border-style: solid;
        }

        .boton-pantalla-completa::before {
            border-width: 2px 0 0 2px;
        }

        .boton-pantalla-completa::after {
            border-width: 0 2px 2px 0;
        }

        .boton-pantalla-completa:hover,
        .boton-pantalla-completa:focus-visible {
            opacity: 1;
            background: rgba(0, 0, 0, 0.55);
            transform: scale(1.04);
            outline: none;
        }

        .bandada-murcielagos-publicidad {
            pointer-events: none;
            position: fixed;
            inset: 0;
            z-index: 30;
            overflow: hidden;
            opacity: 0;
            visibility: hidden;
            transition: opacity 280ms ease, visibility 280ms ease;
        }

        .bandada-murcielagos-publicidad--activa {
            opacity: 1;
            visibility: visible;
        }

        .bandada-murcielagos-publicidad::after {
            position: absolute;
            inset: 0;
            content: "";
            opacity: 0;
            background:
                radial-gradient(ellipse at 15% 78%, rgba(126, 34, 206, 0.28), transparent 30%),
                radial-gradient(ellipse at 85% 24%, rgba(249, 115, 22, 0.22), transparent 28%),
                linear-gradient(100deg, transparent 20%, rgba(30, 10, 43, 0.18) 48%, transparent 76%);
        }

        .bandada-murcielagos-publicidad--activa::after {
            animation: barridoHalloweenPublicidad 8.8s ease-in-out both;
        }

        .murcielago-publicidad {
            position: absolute;
            z-index: 2;
            top: var(--inicio-y);
            left: -12vw;
            width: var(--tamano);
            aspect-ratio: 2 / 1;
            opacity: 0;
            filter:
                drop-shadow(0 0.35rem 0.45rem rgba(0, 0, 0, 0.5))
                drop-shadow(0 0 0.65rem rgba(126, 34, 206, 0.22));
            animation: cruzarMurcielagoPublicidad var(--duracion) cubic-bezier(0.2, 0.64, 0.38, 1) var(--demora) both;
            will-change: transform, opacity;
        }

        .murcielago-publicidad--inverso {
            right: -12vw;
            left: auto;
            animation-name: cruzarMurcielagoPublicidadInverso;
        }

        .murcielago-publicidad::before {
            position: absolute;
            inset: 0;
            content: "";
            background:
                radial-gradient(circle at 46% 44%, #ff9d2e 0 1.8%, transparent 2.5%),
                radial-gradient(circle at 54% 44%, #ff9d2e 0 1.8%, transparent 2.5%),
                linear-gradient(135deg, #120719, #39134a 58%, #18091f);
            clip-path: polygon(50% 31%, 60% 12%, 67% 36%, 100% 10%, 90% 55%, 69% 63%, 59% 82%, 50% 66%, 41% 82%, 31% 63%, 10% 55%, 0 10%, 33% 36%, 40% 12%);
            transform-origin: 50% 48%;
            animation: batirAlasPublicidad 320ms ease-in-out infinite alternate;
        }

        @@keyframes cruzarMurcielagoPublicidad {
            0% {
                opacity: 0;
                transform: translate3d(-8vw, 0, 0) rotate(-9deg) scale(0.72);
            }

            9%,
            86% {
                opacity: var(--opacidad);
            }

            48% {
                transform: translate3d(66vw, var(--desvio-medio), 0) rotate(5deg) scale(1.08);
            }

            100% {
                opacity: 0;
                transform: translate3d(132vw, var(--desvio-final), 0) rotate(var(--rotacion)) scale(0.84);
            }
        }

        @@keyframes cruzarMurcielagoPublicidadInverso {
            0% {
                opacity: 0;
                transform: translate3d(8vw, 0, 0) rotate(9deg) scale(0.72) scaleX(-1);
            }

            9%,
            86% {
                opacity: var(--opacidad);
            }

            48% {
                transform: translate3d(-66vw, var(--desvio-medio), 0) rotate(-5deg) scale(1.08) scaleX(-1);
            }

            100% {
                opacity: 0;
                transform: translate3d(-132vw, var(--desvio-final), 0) rotate(var(--rotacion)) scale(0.84) scaleX(-1);
            }
        }

        @@keyframes batirAlasPublicidad {
            from {
                transform: scaleY(1) rotate(-2deg);
            }

            to {
                transform: scaleY(0.52) rotate(2deg);
            }
        }

        @@keyframes barridoHalloweenPublicidad {
            0%,
            100% {
                opacity: 0;
                transform: translateX(-8%);
            }

            18%,
            78% {
                opacity: 1;
            }

            50% {
                transform: translateX(8%);
            }
        }

        @@media (max-aspect-ratio: 4 / 3) {
            .pantalla-publicitaria__visor {
                max-width: 100vw;
                max-height: 100vh;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .bandada-murcielagos-publicidad {
                display: none;
            }
        }
    </style>
</head>
<body>
    <main id="modulo-publicidad"
          class="pantalla-publicitaria"
          data-url-publicidad="/api/publicidad/activa"
          data-modo-pantalla="true"
          data-loop-videos="false">
        <section id="publicidad-visor"
                 class="pantalla-publicitaria__visor"
                 aria-label="Pantalla publicitaria"
                 aria-live="off">
            @if (primeraPublicidad is not null)
            {
                if (primeraPublicidad.TipoRecurso.Equals("Video", StringComparison.OrdinalIgnoreCase))
                {
                    <video class="publicidad-media publicidad-media--visible"
                           src="@primeraPublicidad.UrlRecurso"
                           muted
                           autoplay
                           playsinline
                           preload="auto"></video>
                }
                else
                {
                    <img class="publicidad-media publicidad-media--visible"
                         src="@primeraPublicidad.UrlRecurso"
                         alt="@primeraPublicidad.Titulo"
                         loading="eager"
                         decoding="async" />
                }
            }
        </section>
        <div id="bandadaMurcielagosPublicidad"
             class="bandada-murcielagos-publicidad"
             data-intervalo-ms="120000"
             aria-hidden="true"></div>
        <button id="botonPantallaCompletaPublicidad"
                class="boton-pantalla-completa"
                type="button"
                aria-label="Activar pantalla completa"></button>
    </main>

    <script id="datos-publicidad-inicial" type="application/json">@Html.Raw(publicidadesIniciales)</script>
    <script>
        (function () {
            var modulo = document.getElementById("modulo-publicidad");
            var visor = document.getElementById("publicidad-visor");
            var botonPantallaCompleta = document.getElementById("botonPantallaCompletaPublicidad");
            var bandadaMurcielagos = document.getElementById("bandadaMurcielagosPublicidad");
            var datosIniciales = document.getElementById("datos-publicidad-inicial");
            var urlPublicidad = modulo.getAttribute("data-url-publicidad");
            var repetirVideos = modulo.getAttribute("data-loop-videos") === "true";
            var publicidades = [];
            var indiceActual = 0;
            var temporizador = null;
            var relojRevision = null;
            var relojActualizacion = null;
            var recursoActual = visor ? visor.querySelector(".publicidad-media--visible") : null;
            var inicioRecursoActual = 0;
            var duracionRecursoActualMs = 0;
            var cargandoRecurso = false;
            var relojBandadaMurcielagos = null;
            var limpiezaBandadaMurcielagos = null;

            function limpiarBandadaMurcielagos() {
                if (!bandadaMurcielagos) {
                    return;
                }

                bandadaMurcielagos.classList.remove("bandada-murcielagos-publicidad--activa");
                bandadaMurcielagos.replaceChildren();
                limpiezaBandadaMurcielagos = null;
            }

            function crearMurcielagoPublicidad(indice) {
                var murcielago = document.createElement("span");
                var viajaEnSentidoInverso = indice % 5 === 0;
                var inicioY = 5 + Math.random() * 78;
                var tamano = 3.2 + Math.random() * 5.4;
                var demora = Math.random() * 2.6;
                var duracion = 4.8 + Math.random() * 2.7;
                var desvioMedio = -8 + Math.random() * 17;
                var desvioFinal = -15 + Math.random() * 31;
                var rotacion = -12 + Math.random() * 25;
                var opacidad = 0.74 + Math.random() * 0.24;

                murcielago.className = "murcielago-publicidad" + (viajaEnSentidoInverso ? " murcielago-publicidad--inverso" : "");
                murcielago.style.setProperty("--inicio-y", inicioY.toFixed(2) + "%");
                murcielago.style.setProperty("--tamano", tamano.toFixed(2) + "rem");
                murcielago.style.setProperty("--demora", demora.toFixed(2) + "s");
                murcielago.style.setProperty("--duracion", duracion.toFixed(2) + "s");
                murcielago.style.setProperty("--desvio-medio", desvioMedio.toFixed(2) + "vh");
                murcielago.style.setProperty("--desvio-final", desvioFinal.toFixed(2) + "vh");
                murcielago.style.setProperty("--rotacion", rotacion.toFixed(2) + "deg");
                murcielago.style.setProperty("--opacidad", opacidad.toFixed(2));
                return murcielago;
            }

            function mostrarBandadaMurcielagos() {
                if (!bandadaMurcielagos ||
                    document.hidden ||
                    window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
                    return;
                }

                if (limpiezaBandadaMurcielagos !== null) {
                    window.clearTimeout(limpiezaBandadaMurcielagos);
                }

                bandadaMurcielagos.replaceChildren();
                var fragmento = document.createDocumentFragment();
                for (var indice = 0; indice < 24; indice += 1) {
                    fragmento.appendChild(crearMurcielagoPublicidad(indice));
                }

                bandadaMurcielagos.appendChild(fragmento);
                bandadaMurcielagos.classList.remove("bandada-murcielagos-publicidad--activa");
                void bandadaMurcielagos.offsetWidth;
                bandadaMurcielagos.classList.add("bandada-murcielagos-publicidad--activa");
                limpiezaBandadaMurcielagos = window.setTimeout(limpiarBandadaMurcielagos, 9200);
            }

            function iniciarBandadaMurcielagos() {
                if (!bandadaMurcielagos || relojBandadaMurcielagos !== null) {
                    return;
                }

                var intervalo = Number(bandadaMurcielagos.getAttribute("data-intervalo-ms")) || 120000;
                mostrarBandadaMurcielagos();
                relojBandadaMurcielagos = window.setInterval(mostrarBandadaMurcielagos, intervalo);
            }

            try {
                publicidades = JSON.parse(datosIniciales.textContent || "[]");
            } catch (error) {
                publicidades = [];
            }

            function limpiarTemporizador() {
                if (temporizador !== null) {
                    window.clearTimeout(temporizador);
                    temporizador = null;
                }
            }

            function programarAvance(segundos) {
                limpiarTemporizador();
                inicioRecursoActual = Date.now();
                duracionRecursoActualMs = Math.max(Number(segundos || 1), 1) * 1000;
                temporizador = window.setTimeout(avanzar, duracionRecursoActualMs);
            }

            function avanzar() {
                if (publicidades.length === 0 || cargandoRecurso) {
                    return;
                }

                indiceActual = (indiceActual + 1) % publicidades.length;
                mostrarPublicidadActual();
            }

            function precargarSiguiente() {
                if (publicidades.length < 2) {
                    return;
                }

                var siguiente = publicidades[(indiceActual + 1) % publicidades.length];
                if (String(siguiente.tipoRecurso).toLowerCase() === "imagen") {
                    var imagen = new Image();
                    imagen.src = siguiente.urlRecurso;
                    return;
                }

                var video = document.createElement("video");
                video.muted = true;
                video.playsInline = true;
                video.preload = "metadata";
                video.src = siguiente.urlRecurso;
            }

            function reemplazarRecurso(recursoNuevo) {
                var recursoAnterior = recursoActual;
                recursoActual = recursoNuevo;
                visor.appendChild(recursoNuevo);

                var activar = function () {
                    recursoNuevo.className = "publicidad-media publicidad-media--visible";
                    if (recursoAnterior) {
                        recursoAnterior.className = "publicidad-media publicidad-media--saliente";
                    }
                };

                if (window.requestAnimationFrame) {
                    window.requestAnimationFrame(activar);
                } else {
                    window.setTimeout(activar, 16);
                }

                if (recursoAnterior) {
                    window.setTimeout(function () {
                        if (recursoAnterior.tagName === "VIDEO") {
                            recursoAnterior.pause();
                            recursoAnterior.removeAttribute("src");
                            recursoAnterior.load();
                        }

                        recursoAnterior.remove();
                    }, 760);
                }
            }

            function manejarErrorCarga() {
                cargandoRecurso = false;
                window.setTimeout(avanzar, 1000);
            }

            function mostrarImagen(publicidad) {
                cargandoRecurso = true;
                var imagen = document.createElement("img");
                var cargada = false;
                imagen.alt = publicidad.titulo || "Publicidad";
                imagen.decoding = "async";
                imagen.loading = "eager";
                imagen.className = "publicidad-media";

                function completarCarga() {
                    if (cargada) {
                        return;
                    }

                    cargada = true;
                    cargandoRecurso = false;
                    reemplazarRecurso(imagen);
                    programarAvance(publicidad.duracionSegundos);
                    precargarSiguiente();
                }

                imagen.onload = completarCarga;
                imagen.onerror = manejarErrorCarga;
                imagen.src = publicidad.urlRecurso;

                if (imagen.complete && imagen.naturalWidth > 0) {
                    window.setTimeout(completarCarga, 0);
                }
            }

            function mostrarVideo(publicidad) {
                cargandoRecurso = true;
                var video = document.createElement("video");
                var cargado = false;
                video.className = "publicidad-media";
                video.muted = true;
                video.autoplay = true;
                video.playsInline = true;
                video.preload = "auto";
                video.loop = repetirVideos && publicidades.length === 1;

                function completarCargaVideo() {
                    if (cargado) {
                        return;
                    }

                    cargado = true;
                    cargandoRecurso = false;
                    reemplazarRecurso(video);
                    var reproduccion = video.play();
                    if (reproduccion && typeof reproduccion.catch === "function") {
                        reproduccion.catch(function () {
                            programarAvance(publicidad.duracionSegundos);
                        });
                    }

                    if (!video.loop) {
                        programarAvance(publicidad.duracionSegundos);
                    }

                    precargarSiguiente();
                }

                video.onloadeddata = completarCargaVideo;
                video.oncanplay = completarCargaVideo;
                if (!video.loop) {
                    video.onended = avanzar;
                }
                video.onerror = manejarErrorCarga;
                video.src = publicidad.urlRecurso;

                window.setTimeout(function () {
                    if (video.readyState >= 2) {
                        completarCargaVideo();
                    }
                }, 1500);
            }

            function mostrarPublicidadActual() {
                var publicidad = publicidades[indiceActual];
                if (!publicidad) {
                    return;
                }

                if (String(publicidad.tipoRecurso).toLowerCase() === "video") {
                    mostrarVideo(publicidad);
                    return;
                }

                mostrarImagen(publicidad);
            }

            function iniciarRelojRevision() {
                if (relojRevision !== null) {
                    return;
                }

                relojRevision = window.setInterval(function () {
                    if (publicidades.length < 2 || cargandoRecurso || duracionRecursoActualMs <= 0) {
                        return;
                    }

                    if (Date.now() - inicioRecursoActual >= duracionRecursoActualMs + 750) {
                        avanzar();
                    }
                }, 1000);
            }

            function publicidadesCambiaron(publicidadesNuevas) {
                if (!Array.isArray(publicidadesNuevas) || publicidadesNuevas.length !== publicidades.length) {
                    return true;
                }

                for (var i = 0; i < publicidadesNuevas.length; i += 1) {
                    var actual = publicidades[i];
                    var nueva = publicidadesNuevas[i];
                    if (!actual || !nueva ||
                        actual.id !== nueva.id ||
                        actual.urlRecurso !== nueva.urlRecurso ||
                        actual.tipoRecurso !== nueva.tipoRecurso ||
                        actual.duracionSegundos !== nueva.duracionSegundos ||
                        actual.orden !== nueva.orden) {
                        return true;
                    }
                }

                return false;
            }

            function actualizarPublicidades(publicidadesNuevas) {
                if (!Array.isArray(publicidadesNuevas) || publicidadesNuevas.length === 0 || !publicidadesCambiaron(publicidadesNuevas)) {
                    return;
                }

                var publicidadAnterior = publicidades[indiceActual];
                var idAnterior = publicidadAnterior ? publicidadAnterior.id : null;
                var urlAnterior = publicidadAnterior ? publicidadAnterior.urlRecurso : null;
                var tipoAnterior = publicidadAnterior ? publicidadAnterior.tipoRecurso : null;
                var indiceNuevo = 0;

                if (idAnterior !== null) {
                    for (var i = 0; i < publicidadesNuevas.length; i += 1) {
                        if (publicidadesNuevas[i].id === idAnterior) {
                            indiceNuevo = i;
                            break;
                        }
                    }
                }

                publicidades = publicidadesNuevas;
                indiceActual = Math.min(indiceNuevo, publicidades.length - 1);

                var publicidadActualizada = publicidades[indiceActual];
                if (!cargandoRecurso &&
                    publicidadActualizada &&
                    (publicidadActualizada.urlRecurso !== urlAnterior || publicidadActualizada.tipoRecurso !== tipoAnterior)) {
                    mostrarPublicidadActual();
                }
            }

            function iniciarActualizacionPublicidades() {
                if (!urlPublicidad || relojActualizacion !== null || typeof window.fetch !== "function") {
                    return;
                }

                relojActualizacion = window.setInterval(function () {
                    var separador = urlPublicidad.indexOf("?") === -1 ? "?" : "&";
                    fetch(urlPublicidad + separador + "t=" + Date.now(), {
                        cache: "no-store",
                        headers: {
                            "Cache-Control": "no-cache",
                            "Pragma": "no-cache",
                            "X-Requested-With": "XMLHttpRequest"
                        }
                    })
                        .then(function (respuesta) {
                            return respuesta.ok ? respuesta.json() : null;
                        })
                        .then(function (publicidadesNuevas) {
                            actualizarPublicidades(publicidadesNuevas);
                        })
                        .catch(function () {
                        });
                }, 30000);
            }

            if (botonPantallaCompleta) {
                botonPantallaCompleta.addEventListener("click", function () {
                    try {
                        var elementoPantallaCompleta = document.fullscreenElement
                            || document.webkitFullscreenElement
                            || document.msFullscreenElement;

                        if (elementoPantallaCompleta) {
                            if (document.exitFullscreen) {
                                document.exitFullscreen();
                            } else if (document.webkitExitFullscreen) {
                                document.webkitExitFullscreen();
                            } else if (document.msExitFullscreen) {
                                document.msExitFullscreen();
                            }
                            return;
                        }

                        if (modulo.requestFullscreen) {
                            modulo.requestFullscreen();
                        } else if (modulo.webkitRequestFullscreen) {
                            modulo.webkitRequestFullscreen();
                        } else if (modulo.msRequestFullscreen) {
                            modulo.msRequestFullscreen();
                        }
                    } catch (error) {
                        botonPantallaCompleta.style.display = "none";
                    }
                });
            }

            iniciarActualizacionPublicidades();
            iniciarBandadaMurcielagos();

            if (publicidades.length > 0) {
                iniciarRelojRevision();
                if (recursoActual) {
                    if (recursoActual.tagName === "VIDEO") {
                        recursoActual.muted = true;
                        recursoActual.autoplay = true;
                        recursoActual.playsInline = true;
                        if (typeof recursoActual.play === "function") {
                            try {
                                recursoActual.play();
                            } catch (error) {
                            }
                        }
                    }

                    programarAvance(publicidades[0].duracionSegundos);
                    precargarSiguiente();
                } else {
                    mostrarPublicidadActual();
                }
            }

            document.addEventListener("visibilitychange", function () {
                if (!document.hidden && publicidades.length > 1 && duracionRecursoActualMs > 0) {
                    programarAvance(Math.max(1, Math.ceil((duracionRecursoActualMs - (Date.now() - inicioRecursoActual)) / 1000)));
                }
            });
        })();
    </script>
</body>
</html>
