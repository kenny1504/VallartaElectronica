@model IReadOnlyCollection<ElectronicaVallarta.Modelos.Dto.PublicidadActivaDto>
@{
    Layout = null;
    ViewData["Title"] = "Publicidad";
    var publicidadesIniciales = System.Text.Json.JsonSerializer.Serialize(
        Model,
        new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase });
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Electronica Vallarta</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        html,
        body {
            width: 100%;
            height: 100%;
            margin: 0;
            overflow: hidden;
            background: #020617;
        }

        body {
            overscroll-behavior: none;
        }

        .pantalla-publicitaria {
            position: fixed;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100vw;
            height: 100vh;
            background:
                radial-gradient(circle at 50% 50%, rgba(58, 160, 243, 0.16), transparent 46%),
                #020617;
        }

        .pantalla-publicitaria__visor {
            position: relative;
            width: 100vw;
            height: 100vh;
            max-width: calc(100vh * 16 / 9);
            max-height: calc(100vw * 9 / 16);
            background: #000;
            overflow: hidden;
        }

        .pantalla-publicitaria__visor--lleno {
            max-width: none;
            max-height: none;
        }

        .publicidad-media {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: contain;
            opacity: 0;
            transform: scale(1.005);
            transition: opacity 700ms ease, transform 900ms ease;
            background: #000;
        }

        .publicidad-media--visible {
            opacity: 1;
            transform: scale(1);
        }

        .publicidad-media--saliente {
            opacity: 0;
        }

        .boton-pantalla-completa {
            position: fixed;
            top: 1rem;
            right: 1rem;
            z-index: 20;
            width: 3rem;
            height: 3rem;
            border: 1px solid rgba(255, 255, 255, 0.18);
            border-radius: 999px;
            background: rgba(0, 0, 0, 0.28);
            opacity: 0.14;
            cursor: pointer;
            transition: opacity 180ms ease, background 180ms ease, transform 180ms ease;
        }

        .boton-pantalla-completa::before,
        .boton-pantalla-completa::after {
            position: absolute;
            inset: 0.78rem;
            content: "";
            border-color: rgba(255, 255, 255, 0.92);
            border-style: solid;
        }

        .boton-pantalla-completa::before {
            border-width: 2px 0 0 2px;
        }

        .boton-pantalla-completa::after {
            border-width: 0 2px 2px 0;
        }

        .boton-pantalla-completa:hover,
        .boton-pantalla-completa:focus-visible {
            opacity: 1;
            background: rgba(0, 0, 0, 0.55);
            transform: scale(1.04);
            outline: none;
        }

        @@media (max-aspect-ratio: 4 / 3) {
            .pantalla-publicitaria__visor {
                max-width: 100vw;
                max-height: 100vh;
            }
        }
    </style>
</head>
<body>
    <main id="modulo-publicidad"
          class="pantalla-publicitaria"
          data-url-publicidad="/api/publicidad/activa"
          data-modo-pantalla="true"
          data-loop-videos="false">
        <section id="publicidad-visor"
                 class="pantalla-publicitaria__visor"
                 aria-label="Pantalla publicitaria"
                 aria-live="off"></section>
        <button id="botonPantallaCompletaPublicidad"
                class="boton-pantalla-completa"
                type="button"
                aria-label="Activar pantalla completa"></button>
    </main>

    <script id="datos-publicidad-inicial" type="application/json">@Html.Raw(publicidadesIniciales)</script>
    <script>
        (() => {
            const modulo = document.getElementById("modulo-publicidad");
            const visor = document.getElementById("publicidad-visor");
            const botonPantallaCompleta = document.getElementById("botonPantallaCompletaPublicidad");
            const datosIniciales = document.getElementById("datos-publicidad-inicial");
            const repetirVideos = modulo.dataset.loopVideos === "true";
            let publicidades = [];
            let indiceActual = 0;
            let temporizador = null;
            let recursoActual = null;

            try {
                publicidades = JSON.parse(datosIniciales.textContent || "[]");
            } catch {
                publicidades = [];
            }

            function limpiarTemporizador() {
                if (temporizador !== null) {
                    window.clearTimeout(temporizador);
                    temporizador = null;
                }
            }

            function programarAvance(segundos) {
                limpiarTemporizador();
                temporizador = window.setTimeout(avanzar, Math.max(Number(segundos || 1), 1) * 1000);
            }

            function avanzar() {
                if (publicidades.length === 0) {
                    return;
                }

                indiceActual = (indiceActual + 1) % publicidades.length;
                mostrarPublicidadActual();
            }

            function precargarSiguiente() {
                if (publicidades.length < 2) {
                    return;
                }

                const siguiente = publicidades[(indiceActual + 1) % publicidades.length];
                if (String(siguiente.tipoRecurso).toLowerCase() === "imagen") {
                    const imagen = new Image();
                    imagen.loading = "lazy";
                    imagen.src = siguiente.urlRecurso;
                    return;
                }

                const video = document.createElement("video");
                video.muted = true;
                video.playsInline = true;
                video.preload = "metadata";
                video.src = siguiente.urlRecurso;
            }

            function reemplazarRecurso(recursoNuevo) {
                const recursoAnterior = recursoActual;
                recursoActual = recursoNuevo;
                visor.appendChild(recursoNuevo);

                window.requestAnimationFrame(() => {
                    recursoNuevo.classList.add("publicidad-media--visible");
                    if (recursoAnterior) {
                        recursoAnterior.classList.remove("publicidad-media--visible");
                        recursoAnterior.classList.add("publicidad-media--saliente");
                    }
                });

                if (recursoAnterior) {
                    window.setTimeout(() => {
                        if (recursoAnterior.tagName === "VIDEO") {
                            recursoAnterior.pause();
                            recursoAnterior.removeAttribute("src");
                            recursoAnterior.load();
                        }

                        recursoAnterior.remove();
                    }, 760);
                }
            }

            function manejarErrorCarga() {
                programarAvance(1);
            }

            function mostrarImagen(publicidad) {
                const imagen = document.createElement("img");
                imagen.alt = publicidad.titulo || "Publicidad";
                imagen.decoding = "async";
                imagen.loading = "eager";
                imagen.className = "publicidad-media";
                imagen.addEventListener("load", () => {
                    reemplazarRecurso(imagen);
                    programarAvance(publicidad.duracionSegundos);
                    precargarSiguiente();
                }, { once: true });
                imagen.addEventListener("error", manejarErrorCarga, { once: true });
                imagen.src = publicidad.urlRecurso;
            }

            function mostrarVideo(publicidad) {
                const video = document.createElement("video");
                video.className = "publicidad-media";
                video.muted = true;
                video.autoplay = true;
                video.playsInline = true;
                video.preload = "auto";
                video.loop = repetirVideos && publicidades.length === 1;
                video.addEventListener("loadeddata", () => {
                    reemplazarRecurso(video);
                    const reproduccion = video.play();
                    if (reproduccion?.catch) {
                        reproduccion.catch(() => programarAvance(publicidad.duracionSegundos));
                    }

                    if (!video.loop) {
                        programarAvance(publicidad.duracionSegundos);
                    }

                    precargarSiguiente();
                }, { once: true });
                if (!video.loop) {
                    video.addEventListener("ended", avanzar, { once: true });
                }
                video.addEventListener("error", manejarErrorCarga, { once: true });
                video.src = publicidad.urlRecurso;
            }

            function mostrarPublicidadActual() {
                const publicidad = publicidades[indiceActual];
                if (!publicidad) {
                    return;
                }

                if (String(publicidad.tipoRecurso).toLowerCase() === "video") {
                    mostrarVideo(publicidad);
                    return;
                }

                mostrarImagen(publicidad);
            }

            botonPantallaCompleta?.addEventListener("click", async () => {
                try {
                    if (document.fullscreenElement) {
                        await document.exitFullscreen();
                        return;
                    }

                    await modulo.requestFullscreen();
                } catch {
                    botonPantallaCompleta.style.display = "none";
                }
            });

            mostrarPublicidadActual();
        })();
    </script>
</body>
</html>
