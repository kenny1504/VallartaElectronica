@{
    var controladorActual = ViewContext.RouteData.Values["controller"]?.ToString();
    var esSeccionAdministracion = !string.IsNullOrWhiteSpace(controladorActual)
        && (controladorActual.StartsWith("Administracion", System.StringComparison.OrdinalIgnoreCase)
            || string.Equals(controladorActual, "AnaliticaConsultas", System.StringComparison.OrdinalIgnoreCase));
    var clasesBody = esSeccionAdministracion
        ? "seccion-administracion min-h-full overflow-x-hidden bg-cieloMarca text-tinta antialiased"
        : "min-h-full overflow-x-hidden bg-cieloMarca text-tinta antialiased";
}
<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Electronica Vallarta</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ElectronicaVallarta.styles.css" asp-append-version="true" />
</head>
<body class="@clasesBody">
    <div class="min-h-screen bg-[linear-gradient(180deg,_#dcefff_0%,_#eaf5ff_18%,_#d7ebff_52%,_#eef7ff_100%)]">
        <header class="sticky top-0 z-40 border-b border-borde bg-white/90 backdrop-blur-xl">
            <nav class="mx-auto flex max-w-7xl items-center justify-center px-4 py-4 sm:px-6 lg:px-8">
                <a asp-controller="Home" asp-action="Index" class="flex items-center justify-center">
                    <img src="~/img/electronica.png"
                         asp-append-version="true"
                         alt="Electronica Vallarta"
                         class="h-12 w-auto sm:h-14" />
                </a>
            </nav>
        </header>

        <aside class="decoracion-halloween" aria-label="Celebracion de Halloween">
            <div class="decoracion-halloween__encabezado" aria-hidden="true">
                <span class="decoracion-halloween__murcielago"></span>
                <p class="decoracion-halloween__insignia">
                    <span>Temporada de</span>
                    <strong>Halloween</strong>
                </p>
                <span class="decoracion-halloween__murcielago decoracion-halloween__murcielago--derecho"></span>
            </div>
            <div class="decoracion-halloween__particulas" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
            </div>
            <div class="decoracion-halloween__siluetas" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
            </div>
            <div class="decoracion-halloween__costado decoracion-halloween__costado--izquierdo" aria-hidden="true">
                <svg viewBox="0 0 120 150" focusable="false" aria-hidden="true">
                    <path d="M58 23c-3-10 1-18 11-21 2 10-1 17-10 22Z" fill="#447044" />
                    <path d="M60 20c29 0 48 23 45 57-3 37-23 59-45 59S18 114 15 77c-3-34 16-57 45-57Z" fill="#f28c28" />
                    <path d="M39 25c-11 12-15 31-12 53 3 25 13 44 26 54M81 25c11 12 15 31 12 53-3 25-13 44-26 54" fill="none" stroke="#d56b1d" stroke-width="5" stroke-linecap="round" opacity=".72" />
                    <path d="m31 66 17-9-5 18Zm58 0-17-9 5 18ZM39 97c14 13 29 13 43 0l-8 21-10-8-9 8-8-8Z" fill="#3b2148" />
                    <path d="M23 84c21 8 53 8 75 0" fill="none" stroke="#ffb347" stroke-width="3" opacity=".75" />
                </svg>
            </div>
            <div class="decoracion-halloween__costado decoracion-halloween__costado--derecho" aria-hidden="true">
                <svg viewBox="0 0 120 150" focusable="false" aria-hidden="true">
                    <path d="M62 23c3-10-1-18-11-21-2 10 1 17 10 22Z" fill="#447044" />
                    <path d="M60 20c29 0 48 23 45 57-3 37-23 59-45 59S18 114 15 77c-3-34 16-57 45-57Z" fill="#f28c28" />
                    <path d="M39 25c-11 12-15 31-12 53 3 25 13 44 26 54M81 25c11 12 15 31 12 53-3 25-13 44-26 54" fill="none" stroke="#d56b1d" stroke-width="5" stroke-linecap="round" opacity=".72" />
                    <path d="m31 66 17-9-5 18Zm58 0-17-9 5 18ZM39 97c14 13 29 13 43 0l-8 21-10-8-9 8-8-8Z" fill="#3b2148" />
                    <path d="M23 84c21 8 53 8 75 0" fill="none" stroke="#ffb347" stroke-width="3" opacity=".75" />
                </svg>
            </div>
        </aside>

        <main class="animacion-entrada-vista relative z-10 mx-auto max-w-7xl overflow-x-hidden px-4 py-8 sm:px-6 lg:px-8">
            @RenderBody()
        </main>

        <footer class="relative z-10 mt-4 border-t border-borde bg-white/85 px-4 py-3 text-center text-sm font-semibold text-slate-600 shadow-sm sm:px-6 lg:px-8">
            <span>Sistema desarrollado por</span>
            <a href="https://www.ksoftech.com"
               target="_blank"
               rel="noopener noreferrer"
               class="font-bold text-tinta transition hover:text-azulMarca">www.ksoftech.com</a>
        </footer>
    </div>

    <div id="loaderGuardadoGlobal"
         class="loader-guardado-global"
         role="status"
         aria-live="polite"
         aria-hidden="true">
        <div class="loader-guardado-global__panel">
            <div class="loader-guardado-global__animacion" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
            </div>
            <p id="loaderGuardadoTitulo" class="loader-guardado-global__titulo">Guardando cambios</p>
            <p id="loaderGuardadoDetalle" class="loader-guardado-global__detalle">Por favor espera mientras se completa la operacion.</p>
        </div>
    </div>

    <a href="https://wa.me/19512388556"
       target="_blank"
       rel="noopener noreferrer"
       aria-label="Contactar por WhatsApp"
       class="boton-whatsapp-flotante">
        <svg viewBox="0 0 24 24" aria-hidden="true" class="h-7 w-7 fill-current">
            <path d="M19.05 4.91A9.82 9.82 0 0 0 12.03 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.74.45 3.43 1.31 4.93L2 22l5.32-1.39a9.9 9.9 0 0 0 4.71 1.2h.01c5.46 0 9.9-4.44 9.9-9.9 0-2.64-1.03-5.11-2.89-7m-7.02 15.23h-.01a8.26 8.26 0 0 1-4.2-1.15l-.3-.18-3.16.83.84-3.08-.2-.32a8.23 8.23 0 0 1-1.27-4.35c0-4.54 3.69-8.23 8.24-8.23 2.2 0 4.27.86 5.82 2.41a8.18 8.18 0 0 1 2.4 5.82c0 4.54-3.69 8.24-8.23 8.24m4.51-6.16c-.25-.13-1.47-.72-1.7-.8s-.39-.12-.56.12-.64.8-.78.96-.28.19-.53.06a6.77 6.77 0 0 1-1.99-1.23 7.5 7.5 0 0 1-1.38-1.71c-.14-.25-.02-.39.11-.52.11-.11.25-.28.37-.42s.16-.24.25-.4.04-.31-.02-.44-.56-1.35-.77-1.85c-.2-.48-.4-.41-.56-.42h-.47c-.17 0-.44.06-.67.31s-.88.86-.88 2.1.9 2.45 1.02 2.62 1.76 2.69 4.27 3.77c.6.26 1.06.41 1.42.52.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.17s.21-1.06.15-1.17-.22-.17-.47-.3"/>
        </svg>
        <span class="hidden sm:inline">WhatsApp</span>
    </a>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
