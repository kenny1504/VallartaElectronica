@{
    var controladorActual = ViewContext.RouteData.Values["controller"]?.ToString();
    var esSeccionAdministracion = !string.IsNullOrWhiteSpace(controladorActual)
        && (controladorActual.StartsWith("Administracion", System.StringComparison.OrdinalIgnoreCase)
            || string.Equals(controladorActual, "AnaliticaConsultas", System.StringComparison.OrdinalIgnoreCase));
    var clasesBody = esSeccionAdministracion
        ? "seccion-administracion min-h-full overflow-x-hidden bg-cieloMarca text-tinta antialiased"
        : "min-h-full overflow-x-hidden bg-cieloMarca text-tinta antialiased";
}
<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Electronica Vallarta</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ElectronicaVallarta.styles.css" asp-append-version="true" />
</head>
<body class="@clasesBody">
    <div class="min-h-screen bg-[linear-gradient(180deg,_#dcefff_0%,_#eaf5ff_18%,_#d7ebff_52%,_#eef7ff_100%)]">
        <header class="sticky top-0 z-40 border-b border-borde bg-white/90 backdrop-blur-xl">
            <nav class="mx-auto flex max-w-7xl items-center justify-center px-4 py-4 sm:px-6 lg:px-8">
                <a asp-controller="Home" asp-action="Index" class="flex items-center justify-center">
                    <img src="~/img/electronica.png"
                         asp-append-version="true"
                         alt="Electronica Vallarta"
                         class="h-12 w-auto sm:h-14" />
                </a>
            </nav>
        </header>

        <aside class="decoracion-mundial" aria-label="Celebracion del Mundial FIFA 2026">
            <div class="decoracion-mundial__banderas" aria-hidden="true">
                <span class="decoracion-mundial__bandera decoracion-mundial__bandera--canada"></span>
                <span class="decoracion-mundial__bandera decoracion-mundial__bandera--mexico"></span>
                <span class="decoracion-mundial__bandera decoracion-mundial__bandera--estados-unidos"></span>
            </div>
            <div class="decoracion-mundial__confeti" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
            </div>
            <div class="decoracion-mundial__costado decoracion-mundial__costado--izquierdo" aria-hidden="true">
                <svg viewBox="0 0 120 180" focusable="false" aria-hidden="true">
                    <defs>
                        <linearGradient id="gradienteTrofeoMundialIzquierdo" x1="22" x2="98" y1="18" y2="150" gradientUnits="userSpaceOnUse">
                            <stop offset="0" stop-color="#fff2a8" />
                            <stop offset=".22" stop-color="#d6a530" />
                            <stop offset=".52" stop-color="#f2d16c" />
                            <stop offset=".78" stop-color="#9d6a17" />
                            <stop offset="1" stop-color="#f7dc82" />
                        </linearGradient>
                        <radialGradient id="brilloTrofeoMundialIzquierdo" cx="38%" cy="22%" r="62%">
                            <stop offset="0" stop-color="#ffffff" stop-opacity=".85" />
                            <stop offset=".28" stop-color="#ffffff" stop-opacity=".25" />
                            <stop offset="1" stop-color="#ffffff" stop-opacity="0" />
                        </radialGradient>
                    </defs>
                    <path d="M60 7c17 0 32 12 35 29 2 13-4 29-14 39-7 8-11 17-10 29 1 13 7 22 17 29H32c10-7 16-16 17-29 1-12-3-21-10-29-10-10-16-26-14-39C28 19 43 7 60 7Z" fill="url(#gradienteTrofeoMundialIzquierdo)" />
                    <path d="M31 38c-9 5-15 16-13 28 2 14 13 22 28 23" fill="none" stroke="#c48a24" stroke-width="10" stroke-linecap="round" />
                    <path d="M89 38c9 5 15 16 13 28-2 14-13 22-28 23" fill="none" stroke="#b9781c" stroke-width="10" stroke-linecap="round" />
                    <path d="M42 39c10-7 23-7 36 0M42 74c11 9 25 9 36 0M47 117c8 5 18 5 26 0" fill="none" stroke="#7d4f12" stroke-width="3" stroke-linecap="round" opacity=".45" />
                    <path d="M56 19c-10 10-12 29-3 45 4 8 5 18 2 30-2 9-5 18-13 27" fill="none" stroke="#fff0aa" stroke-width="5" stroke-linecap="round" opacity=".55" />
                    <path d="M67 20c9 14 8 28-2 42-6 9-6 20 1 34 5 10 12 18 22 25" fill="none" stroke="#70440f" stroke-width="5" stroke-linecap="round" opacity=".33" />
                    <path d="M39 132h42l7 26H32l7-26Z" fill="#0f766e" />
                    <path d="M34 154h52l7 14H27l7-14Z" fill="#14324a" />
                    <path d="M38 132h44" fill="none" stroke="#f8df84" stroke-width="4" stroke-linecap="round" />
                    <path d="M38 159h44" fill="none" stroke="#38bdf8" stroke-width="3" stroke-linecap="round" opacity=".85" />
                    <path d="M60 7c17 0 32 12 35 29 2 13-4 29-14 39-7 8-11 17-10 29 1 13 7 22 17 29H32c10-7 16-16 17-29 1-12-3-21-10-29-10-10-16-26-14-39C28 19 43 7 60 7Z" fill="url(#brilloTrofeoMundialIzquierdo)" />
                </svg>
            </div>
            <div class="decoracion-mundial__costado decoracion-mundial__costado--derecho" aria-hidden="true">
                <svg viewBox="0 0 120 180" focusable="false" aria-hidden="true">
                    <defs>
                        <linearGradient id="gradienteTrofeoMundialDerecho" x1="22" x2="98" y1="18" y2="150" gradientUnits="userSpaceOnUse">
                            <stop offset="0" stop-color="#fff2a8" />
                            <stop offset=".22" stop-color="#d6a530" />
                            <stop offset=".52" stop-color="#f2d16c" />
                            <stop offset=".78" stop-color="#9d6a17" />
                            <stop offset="1" stop-color="#f7dc82" />
                        </linearGradient>
                        <radialGradient id="brilloTrofeoMundialDerecho" cx="38%" cy="22%" r="62%">
                            <stop offset="0" stop-color="#ffffff" stop-opacity=".85" />
                            <stop offset=".28" stop-color="#ffffff" stop-opacity=".25" />
                            <stop offset="1" stop-color="#ffffff" stop-opacity="0" />
                        </radialGradient>
                    </defs>
                    <path d="M60 7c17 0 32 12 35 29 2 13-4 29-14 39-7 8-11 17-10 29 1 13 7 22 17 29H32c10-7 16-16 17-29 1-12-3-21-10-29-10-10-16-26-14-39C28 19 43 7 60 7Z" fill="url(#gradienteTrofeoMundialDerecho)" />
                    <path d="M31 38c-9 5-15 16-13 28 2 14 13 22 28 23" fill="none" stroke="#c48a24" stroke-width="10" stroke-linecap="round" />
                    <path d="M89 38c9 5 15 16 13 28-2 14-13 22-28 23" fill="none" stroke="#b9781c" stroke-width="10" stroke-linecap="round" />
                    <path d="M42 39c10-7 23-7 36 0M42 74c11 9 25 9 36 0M47 117c8 5 18 5 26 0" fill="none" stroke="#7d4f12" stroke-width="3" stroke-linecap="round" opacity=".45" />
                    <path d="M56 19c-10 10-12 29-3 45 4 8 5 18 2 30-2 9-5 18-13 27" fill="none" stroke="#fff0aa" stroke-width="5" stroke-linecap="round" opacity=".55" />
                    <path d="M67 20c9 14 8 28-2 42-6 9-6 20 1 34 5 10 12 18 22 25" fill="none" stroke="#70440f" stroke-width="5" stroke-linecap="round" opacity=".33" />
                    <path d="M39 132h42l7 26H32l7-26Z" fill="#0f766e" />
                    <path d="M34 154h52l7 14H27l7-14Z" fill="#14324a" />
                    <path d="M38 132h44" fill="none" stroke="#f8df84" stroke-width="4" stroke-linecap="round" />
                    <path d="M38 159h44" fill="none" stroke="#38bdf8" stroke-width="3" stroke-linecap="round" opacity=".85" />
                    <path d="M60 7c17 0 32 12 35 29 2 13-4 29-14 39-7 8-11 17-10 29 1 13 7 22 17 29H32c10-7 16-16 17-29 1-12-3-21-10-29-10-10-16-26-14-39C28 19 43 7 60 7Z" fill="url(#brilloTrofeoMundialDerecho)" />
                </svg>
            </div>
        </aside>

        <main class="animacion-entrada-vista relative z-10 mx-auto max-w-7xl overflow-x-hidden px-4 py-8 sm:px-6 lg:px-8">
            @RenderBody()
        </main>

        <footer class="relative z-10 mt-4 border-t border-borde bg-white/85 px-4 py-3 text-center text-sm font-semibold text-slate-600 shadow-sm sm:px-6 lg:px-8">
            <span>Sistema desarrollado por</span>
            <a href="https://www.ksoftech.com"
               target="_blank"
               rel="noopener noreferrer"
               class="font-bold text-tinta transition hover:text-azulMarca">www.ksoftech.com</a>
        </footer>
    </div>

    <a href="https://wa.me/19512388556"
       target="_blank"
       rel="noopener noreferrer"
       aria-label="Contactar por WhatsApp"
       class="boton-whatsapp-flotante">
        <svg viewBox="0 0 24 24" aria-hidden="true" class="h-7 w-7 fill-current">
            <path d="M19.05 4.91A9.82 9.82 0 0 0 12.03 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.74.45 3.43 1.31 4.93L2 22l5.32-1.39a9.9 9.9 0 0 0 4.71 1.2h.01c5.46 0 9.9-4.44 9.9-9.9 0-2.64-1.03-5.11-2.89-7m-7.02 15.23h-.01a8.26 8.26 0 0 1-4.2-1.15l-.3-.18-3.16.83.84-3.08-.2-.32a8.23 8.23 0 0 1-1.27-4.35c0-4.54 3.69-8.23 8.24-8.23 2.2 0 4.27.86 5.82 2.41a8.18 8.18 0 0 1 2.4 5.82c0 4.54-3.69 8.24-8.23 8.24m4.51-6.16c-.25-.13-1.47-.72-1.7-.8s-.39-.12-.56.12-.64.8-.78.96-.28.19-.53.06a6.77 6.77 0 0 1-1.99-1.23 7.5 7.5 0 0 1-1.38-1.71c-.14-.25-.02-.39.11-.52.11-.11.25-.28.37-.42s.16-.24.25-.4.04-.31-.02-.44-.56-1.35-.77-1.85c-.2-.48-.4-.41-.56-.42h-.47c-.17 0-.44.06-.67.31s-.88.86-.88 2.1.9 2.45 1.02 2.62 1.76 2.69 4.27 3.77c.6.26 1.06.41 1.42.52.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.17s.21-1.06.15-1.17-.22-.17-.47-.3"/>
        </svg>
        <span class="hidden sm:inline">WhatsApp</span>
    </a>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
